# --- Required -------------------------------------------------------------
TELEGRAM_TOKEN=123456:ABC-your-bot-token

# --- Access & limits -------------------------------------------------------
# Your Telegram user id(s): unlimited use, /stats with admin info, /grant /revoke premium
ADMIN_IDS=
# Comma-separated user ids allowed to use the bot; empty = everyone (it runs on your home network!)
ALLOWED_USERS=
# Translations per day for normal users (0 = unlimited). Re-sending a cached result is free.
FREE_DAILY_LIMIT=1
MAX_DURATION_MIN=90
JOB_TIMEOUT_MIN=40
# Don't start a job with less free disk than this (a job needs ~3x the upload limit temporarily)
MIN_FREE_DISK_MB=400
# Pi 3: keep 1 (CPU/RAM). A bigger machine can run 2-3.
MAX_PARALLEL_JOBS=1
MAX_QUEUE=10

# --- Output ---------------------------------------------------------------
DEFAULT_SRC=auto
DEFAULT_DST=ru
MAX_VIDEO_HEIGHT=720
# Telegram upload limit in MB (default 49; ~1950 with a local Bot API server)
UPLOAD_LIMIT_MB=
# Original soundtrack volume under the translated voice; 0 = drop it (the voice is then muxed as-is when it fits)
MIX_ORIGINAL_VOLUME=0.25
# speech = mono 24 kHz (cheap to encode on a Pi; the voice is mono anyway), music = stereo 48 kHz
AUDIO_QUALITY=speech
# Max audio bitrate (default 64k for speech, 128k for music); lowered automatically on long videos
AUDIO_BITRATE=
# Local Bot API server (see docker-compose.yml) lifts the 50 MB upload limit to 2000 MB
TELEGRAM_API_SERVER=

# --- Engines --------------------------------------------------------------
# Voice: ytdub = YouTube's own AI dub track (instant, free), yandex = Yandex voice-over (to ru/en/kk),
#        tts = captions/speech recognition -> machine translation -> speech synthesis (any language)
VOICE_ENGINES=ytdub,yandex,tts
# Machine translation, in order; keyed engines are skipped when their key is empty.
# yandex and google are free unofficial endpoints and are always kept as the last resort.
MT_ENGINES=llm,deepl,yandex,google
TTS_ENGINES=edge,gtts

# Optional keys (all have free tiers)
# Groq: free Whisper speech recognition for videos without captions (https://console.groq.com)
GROQ_API_KEY=
# Any OpenAI-compatible LLM for better, context-aware translation. Defaults to Groq (same free key works).
# Gemini: LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai  LLM_MODEL=gemini-2.5-flash
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
# DeepL API Free (500k chars/month); keys ending in :fx use the free endpoint
DEEPL_API_KEY=
# Yandex OAuth token enables "lively voices" (en->ru only)
YANDEX_OAUTH_TOKEN=

# --- Network ----------------------------------------------------------------
# e.g. socks5://user:pass@host:1080 - needed where YouTube or Telegram is blocked
YTDLP_PROXY=
VOT_PROXY=
TELEGRAM_PROXY=
# Netscape cookies.txt (inside the container, e.g. /data/cookies.txt) if YouTube asks to sign in
YTDLP_COOKIES=
# Daily, and only while no job is running
YTDLP_AUTO_UPDATE=1
# JavaScript runtime for YouTube challenges; the image sets node:/app/bin/node-lowmem (heap-capped Node)
# YTDLP_JS_RUNTIMES=
LOG_LEVEL=INFO
